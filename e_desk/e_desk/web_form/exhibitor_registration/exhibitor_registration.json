 "client_script": "frappe.web_form.after_load = function() {\n    // Cache for stall items and their max staff\n    frappe.web_form.stall_items = {};\n\nfrappe.call({\n    method: \"e_desk.e_desk.api.webform.get_stall_items\",\n    callback: function (r) {\n        const items = r.message || [];\n\n        frappe.web_form.stall_items = {};\n\n        const options = items.map(i => {\n            frappe.web_form.stall_items[i.name] =\n                i.custom_max_staff_allowed || 0;\n            return i.name;\n        });\n\n        const stall_field = frappe.web_form.fields_dict[\"stall\"];\n        if (stall_field) {\n            stall_field.df.options = options;\n            stall_field.refresh();\n        }\n    }\n});\n\n\n    // Set max_staff_allowed in web form when a stall is selected\n    frappe.web_form.on('stall', function(field, value) {\n        const max_staff_field = frappe.web_form.fields_dict['max_staff_allowed'];\n        if(max_staff_field && value) {\n            const max_staff = frappe.web_form.stall_items[value] || 0;\n            max_staff_field.set_value(max_staff);\n        }\n    });\n    \n     frappe.call({\n        method: \"e_desk.e_desk.doctype.participant.participant.get_meal_settings_for_webform\",\n        callback(r) {\n            if (!r.message) return;\n\n            const has_meal = cint(r.message.has_meal);\n            const meal_access = r.message.meal_access;\n            function set_info_html(html) {\n                $('#info_html').html(html || '');\n            }\n\n            // CASE 1: Meals disabled globally\n            if (!has_meal) {\n                frappe.web_form.set_df_property('meal_included', 'hidden', 1);\n                frappe.web_form.set_df_property('meal_preference', 'hidden', 1);\n                frappe.web_form.set_value('meal_included', 0);\n                // Clear info text\n                set_info_html('');\n                return;\n            }\n\n            // CASE 2: Meals enabled\n            frappe.web_form.set_df_property('meal_included', 'hidden', 1);\n            frappe.web_form.set_df_property('meal_preference', 'hidden', 0);\n            \n             set_info_html(`\n                <div class=\"alert alert-warning\">\n                    Meal is a <b>paid add-on</b>. Additional charges apply if you opt for meals.\n                </div>\n            `);\n\n            // CASE 3: Free meal for all\n            if (meal_access === \"Free for All Participants\") {\n                frappe.web_form.set_value('meal_included', 1);\n                frappe.web_form.set_df_property('meal_included', 'read_only', 1);\n                frappe.web_form.set_df_property('meal_included', 'hidden', 1);\n                \n                set_info_html(`\n                    <div class=\"alert alert-success\">\n                        Meals are <b>free</b>.\n                    </div>\n                `);\n                return;eturn;\n            }\n\n            // CASE 4: Meal purchased via webshop\n          \n            // CASE 5: Meal optional / paid\n            frappe.web_form.set_value('meal_included', 0);\n            frappe.web_form.set_df_property('meal_included', 'read_only', 0);\n        },\n        error(err) {\n            console.error(\"Meal settings error:\", err);\n        }\n    });\n};\n",
